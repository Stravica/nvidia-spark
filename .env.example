# Copy to .env and fill in a real Hugging Face token.
# .env is gitignored; never commit real tokens.
#
# Get one at: https://huggingface.co/settings/tokens
# Read scope is enough for public checkpoints; some Meta Llama variants require accepting
# the license first on the model page before your token can pull them.
HF_TOKEN=hf_your_token_here
